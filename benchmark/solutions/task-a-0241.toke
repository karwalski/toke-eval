m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input.get(0);let targets=input.get(1);let result=smallestsubarray(arr;targets);j.print(result);};f=smallestsubarray(arr:@i64;targets:@i64):i64{if(targets.len==0 as u64){<0};let targetset=mut.@();lp(let i=0 as u64;i<targets.len;i=i+1){let val=targets.get(i);let found=mut.false;lp(let j=0 as u64;j<targetset.len;j=j+1){if(targetset.get(j)==val){found=true;br;};};if(!(found)){targetset=targetset+@(val);};};let n=arr.len;let m=targetset.len;let minlen=mut.n+1;let left=mut.0;let right=mut.0;let found=mut.false;lp(let i=0 as u64;i<n;i=i+1){let current=arr.get(i);let intargets=mut.false;lp(let j=0 as u64;j<m;j=j+1){if(targetset.get(j)==current){intargets=true;br;};};if(intargets){if(!(found)){left=i as i64;found=true;};right=i as i64;};};if(!(found)){<-1};let currentlen=right-left+1;if(currentlen<minlen){minlen=currentlen;};<minlen};