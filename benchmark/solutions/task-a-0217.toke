m=prefixmax;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=prefixmax(parsed);j.print(result);};f=prefixmax(arr:@i64):@i64{let n=arr.len;let result=mut.@();let currentmax=mut.0;lp(let i=0;i<n;i=i+1){let elem=arr.get(i);if(i==0){currentmax=elem}el{if(elem>currentmax){currentmax=elem}};result=result+@(currentmax);};<result};