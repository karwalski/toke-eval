m=uniquecount;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let result=uniqueCount(arr);j.print(result);};f=uniqueCount(arr:@i64):i64{let n=arr.len;let count=mut.0;lp(let i=0;i<n;i=i+1){let found=mut.false;lp(let j=0;j<i;j=j+1){if(arr.get(j)=arr.get(i)){found=true;};};if(!(found)){count=count+1;};};<count};
