m=issubseq;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let a=input.get(0);let b=input.get(1);let result=issubseq(a;b);j.print(result);};f=issubseq(a:@i64;b:@i64):bool{let i=mut.0;let j=mut.0;let n=a.len;let m=b.len;let found=mut.false;lp(let i=0;i<n;i=i+1){let found=mut.false;lp(let j=0;j<m;j=j+1){if(a.get(i)=b.get(j)){found=true;br;};};if(found=false){<false};};<true};
