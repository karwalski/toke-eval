m=zigzag;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let val=mut.input as i64;let isneg=mut.false;if(val<0){isneg=true;val=0-val};let result=mut.0;let power=mut.1;lp(let i=0;i<64;i=i+1){let bit=val-val/2*2;if(bit!=0){result=result+power};power=power+power;val=val/2};if(isneg){result=0-result};j.print(result)};