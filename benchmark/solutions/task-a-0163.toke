m=interleave;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr1=input.get(0);let arr2=input.get(1);let result=interleave(arr1;arr2);j.print(result);};f=interleave(a:@i64;b:@i64):@i64{let n=a.len;let result=mut.@();lp(let i=0;i<n;i=i+1){result=result+@(a.get(i));result=result+@(b.get(i));};<result};
