m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input.get(0);let target=input.get(1);let count=mut.0;let n=arr.len;lp(let i=0;i<n;i=i+1){let currentsum=mut.0;lp(let j=i;j<n;j=j+1){currentsum=currentsum+arr.get(j);if(currentsum==target){count=count+1;};};};j.print(count);};