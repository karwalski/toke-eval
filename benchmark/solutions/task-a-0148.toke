m=runlen;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=runLengthDecode(input);j.print(result);};f=runLengthDecode(arr:@@i64):@i64{let n=arr.len;let result=mut.@();lp(let i=0;i<n;i=i+1){let val=arr.get(i).get(0);let count=arr.get(i).get(1);let m=mut.0;lp(let j=0;j<count;j=j+1){result=result+@(val);};};<result};
