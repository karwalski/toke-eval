m=transpose;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let matrix=parsed;let n=matrix.len;let m=matrix.get(0 as u64).len;let result=mut.@();lp(let i=0;i<m;i=i+1){let row=mut.@();lp(let j=0;j<n;j=j+1){row=row+@(matrix.get(j as u64).get(i as u64));};result=result+@(row);};j.print(result);};
