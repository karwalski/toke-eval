m=removeDupChars;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=removeDupChars(input);j.print(result);};f=removeDupChars(s:Str):Str{let n=s.len;let result=mut."";lp(let i=0;i<n;i=i+1){let ch=s.get(i);let found=mut.false;lp(let j=0;j<result.len;j=j+1){if(result.get(j)=ch){found=true;br;}};if(!(found)){result=result+ch;}};<result};
