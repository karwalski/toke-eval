m=substring;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let s=input.get(0);let sub=input.get(1);let result=mut.false;let n=s.len;let m=sub.len;if(!(m>n)){let found=mut.false;lp(let i=0;i<n-m+1;i=i+1){let match=mut.true;lp(let j=0;j<m;j=j+1){if(!(s.get(i+j)=sub.get(j))){match=false}};if(match){found=true}};result=found};j.print(result)};
