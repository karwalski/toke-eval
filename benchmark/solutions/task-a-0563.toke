m=hasduplicates;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let result=hasDuplicates(arr);j.print(result);};f=hasDuplicates(arr:@i64):bool{let n=arr.len;lp(let i=0;i<n;i=i+1){let val=arr.get(i);let found=mut.false;lp(let j=0;j<n;j=j+1){if(j=i){br;};if(arr.get(j)=val){found=true;};};if(found){<true;};};<false;};
