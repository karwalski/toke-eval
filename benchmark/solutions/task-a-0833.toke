m=evenfilter;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=evenFilter(parsed);j.print(result);};f=evenFilter(arr:@i64):@i64{let result=mut.@();lp(let i=0;i<arr.len;i=i+1){let elem=arr.get(i);let mod=elem-elem/2*2;if(mod=0){result=result+@(elem);};};<result};
