m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input as @i64;let result=helper(arr);j.print(result);};f=helper(arr:@i64):@i64{let n=arr.len;if(n==0 as u64){<@()};let maxstart=mut.0;let maxend=mut.0;let maxsum=mut.0;let currentstart=mut.0;let currentsum=mut.0;lp(let i=0 as u64;i<n;i=i+1){let current=arr.get(i);if(currentsum>0){currentsum=currentsum+current}el{currentsum=current;currentstart=i};if(currentsum>maxsum){maxsum=currentsum;maxstart=currentstart;maxend=i}};<@(maxstart as i64;maxend as i64;maxsum)};