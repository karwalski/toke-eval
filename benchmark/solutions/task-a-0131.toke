m=checkStrictlyIncreasing;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=checkStrictlyIncreasing(parsed);j.print(result);};f=checkStrictlyIncreasing(arr:@i64):bool{if(arr.len=0 as u64){<true};if(arr.len=1 as u64){<true};let n=arr.len;let m=mut.0;lp(let i=0;i<n-1 as u64;i=i+1){let current=arr.get(i);let next=arr.get(i+1 as u64);if(!(current<next)){<false};};<true};
