m=removeAll;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input.get(0);let val=input.get(1);let result=removeAll(arr,val);j.print(result);};f=removeAll(arr:@i64;val:i64):@i64{let result=mut.@();lp(let i=0;i<arr.len;i=i+1){if(!(arr.get(i)=val)){result=result+@(arr.get(i));};};<result};
