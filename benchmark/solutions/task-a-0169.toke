m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let n=arr.len;let minIdx=mut.0;let minVal=mut.arr.get(0);lp(let i=1;i<n;i=i+1){if(arr.get(i)<minVal){minVal=arr.get(i);minIdx=i;};};let sum=mut.0;lp(let i=0;i<n;i=i+1){if(!(i=minIdx)){sum=sum+arr.get(i);};};j.print(sum);};
