m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input as @i64;let n=arr.len;let minidx=mut.0;let minval=mut.arr.get(0);lp(let i=1;i<n;i=i+1){if(arr.get(i)<minval){minval=arr.get(i);minidx=i;};};let sum=mut.0;lp(let i=0;i<n;i=i+1){if(!(i==minidx)){sum=sum+arr.get(i);};};j.print(sum);};