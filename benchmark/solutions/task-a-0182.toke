m=unique;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=hasUniqueChars(input);j.print(result);};f=hasUniqueChars(s:Str):bool{let n=s.len;if(n=0){<true};let m=mut.0;lp(let i=0;i<n;i=i+1){let c=s.get(i);let found=mut.false;lp(let j=0;j<m;j=j+1){if(s.get(j)=c){found=true;br;};};if(found){<false};m=m+1;};<true};
