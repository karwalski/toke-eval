m=kth;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input.get(0);let k=input.get(1);let sorted=mut.@();lp(let i=0;i<arr.len;i=i+1){sorted=sorted+@(arr.get(i));};lp(let i=0;i<sorted.len;i=i+1){lp(let j=0;j+1<sorted.len;j=j+1){if(sorted.get(j)>sorted.get(j+1)){let tmp=sorted.get(j);sorted.set(j;sorted.get(j+1));sorted.set(j+1;tmp);};};};let result=sorted.get(k-1);j.print(result);};
