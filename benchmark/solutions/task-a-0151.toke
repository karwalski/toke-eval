m=binstrtoi64;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=mut.0;let isNeg=mut.false;let str=parsed as Str;if(str.get(0)=45){isNeg=true;str=str.get(1)};let n=str.len;lp(let i=0;i<n;i=i+1){let c=str.get(i);if(c<48){<0};if(c>57){<0};let digit=c-48;result=result*2+digit};if(isNeg){result=0-result};j.print(result)};
