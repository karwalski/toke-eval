m=binstrtoi64;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=mut.0;let isneg=mut.false;let str=mut.parsed as str;if(str.charat(0)==45){isneg=true;str=str.slice(1;2)};let n=str.len;lp(let i=0;i<n;i=i+1){let c=str.charat(i);if(c<48){j.print(0);<0};if(c>57){j.print(0);<0};let digit=c-48;result=result*2+digit};if(isneg){result=0-result};j.print(result)};