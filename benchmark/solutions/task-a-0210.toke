m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input as @i64;let n=arr.len;let maxsum=mut.0;let currentsum=mut.0;lp(let i=0;i<n;i=i+1){let num1=arr.get(i);let num2=currentsum+num1;if(num2>num1){currentsum=num2}el{currentsum=num1};if(currentsum>maxsum){maxsum=currentsum}};j.print(maxsum)};