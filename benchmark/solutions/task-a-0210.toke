m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let n=arr.len;let maxSum=mut.0;let currentSum=mut.0;lp(let i=0;i<n;i=i+1){let num1=arr.get(i);let num2=currentSum+num1;if(num2>num1){currentSum=num2}el{currentSum=num1};if(currentSum>maxSum){maxSum=currentSum}};j.print(maxSum)};
