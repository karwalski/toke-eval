m=checkNonDecreasing;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=checkNonDecreasing(parsed);j.print(result);};f=checkNonDecreasing(arr:@i64):bool{let n=arr.len;let m=mut.0;lp(let i=0;i+1<n;i=i+1){let curr=arr.get(i);let next=arr.get(i+1);if(curr>next){<false};};<true};
