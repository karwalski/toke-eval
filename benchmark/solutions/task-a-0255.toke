m=arrdiff;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr1=input.get(0);let arr2=input.get(1);let result=arrdiff(arr1;arr2);j.print(result);};f=arrdiff(arr1:@i64;arr2:@i64):@i64{let result=mut.@();lp(let i=0;i<arr1.len;i=i+1){let found=mut.false;lp(let j=0;j<arr2.len;j=j+1){if(arr1.get(i)=arr2.get(j)){found=true;};};if(!(found)){result=result+@(arr1.get(i));};};<result};
