m=partition;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let arr=parsed.get(0);let pivot=parsed.get(1);let result=partition(arr;pivot);j.print(result);};f=partition(arr:@i64;pivot:i64):@@i64{let less=mut.@();let equal=mut.@();let greater=mut.@();lp(let i=0;i<arr.len;i=i+1){let elem=arr.get(i);if(elem<pivot){less=less+@(elem);}el{if(elem=pivot){equal=equal+@(elem);}el{greater=greater+@(elem);};};};<@(less;equal;greater)};
