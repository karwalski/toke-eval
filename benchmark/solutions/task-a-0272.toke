m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=sortCount(input);j.print(result);};f=sortCount(arr:@i64):@@i64{let n=arr.len;let unique=mut.@();let counts=mut.@();lp(let i=0;i<n;i=i+1){let val=arr.get(i);let found=mut.false;let idx=mut.0;lp(let j=0;j<unique.len;j=j+1){if(unique.get(j)=val){found=true;idx=j;};};if(found){counts.set(idx;counts.get(idx)+1);}el{unique=unique+@(val);counts=counts+@(1);};};let m=unique.len;lp(let i=0;i<m;i=i+1){lp(let j=0;j+1<m-i;j=j+1){if(unique.get(j)>unique.get(j+1)){let tmp=unique.get(j);unique.set(j;unique.get(j+1));unique.set(j+1;tmp);let tmpc=counts.get(j);counts.set(j;counts.get(j+1));counts.set(j+1;tmpc);};};};let result=mut.@();lp(let i=0;i<m;i=i+1){result=result+@(@(unique.get(i);counts.get(i)));};<result};
