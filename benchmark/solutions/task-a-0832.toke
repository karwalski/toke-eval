m=filterPos;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=filterPositive(parsed);j.print(result);};f=filterPositive(arr:@i64):@i64{let n=arr.len;let result=mut.@();lp(let i=0;i<n;i=i+1){let elem=arr.get(i);if(elem>0){result=result+@(elem);};};<result};
