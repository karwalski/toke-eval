m=mostfreq;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input as @i64;let result=mostfreq(arr);j.print(result);};f=mostfreq(arr:@i64):i64{let n=arr.len;let maxfreq=mut.0;let maxval=mut.0;lp(let i=0;i<n;i=i+1){let val=arr.get(i);let freq=mut.0;lp(let j=0;j<n;j=j+1){if(arr.get(j)==val){freq=freq+1;};};if(freq>maxfreq){maxfreq=freq;maxval=val;}el{if(freq==maxfreq){if(val<maxval){maxval=val;};};};};<maxval};