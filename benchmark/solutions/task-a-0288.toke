m=mostFreq;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let result=mostFreq(arr);j.print(result);};f=mostFreq(arr:@i64):i64{let n=arr.len;let maxFreq=mut.0;let maxVal=mut.0;lp(let i=0;i<n;i=i+1){let val=arr.get(i);let freq=mut.0;lp(let j=0;j<n;j=j+1){if(arr.get(j)=val){freq=freq+1;};};if(freq>maxFreq){maxFreq=freq;maxVal=val;}el{if(freq=maxFreq){if(val<maxVal){maxVal=val;};};};};<maxVal};
