m=removezeros;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=removezeros(input);j.print(result);};f=removezeros(arr:@i64):@i64{let n=arr.len;let result=mut.@();let inzerorun=mut.false;lp(let i=0;i<n;i=i+1){let elem=arr.get(i);if(elem==0){if(inzerorun){}el{result=result+@(0);inzerorun=true;};}el{result=result+@(elem);inzerorun=false;};};<result};