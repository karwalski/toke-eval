m=palindrome;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input as @i64;let result=checkpalindrome(arr);j.print(result);};f=checkpalindrome(arr:@i64):bool{let n=arr.len;let m=mut.0;let ispal=mut.true;lp(let i=0;i<n;i=i+1){m=n-1-i;if(!(arr.get(i)==arr.get(m))){ispal=false}};<ispal};