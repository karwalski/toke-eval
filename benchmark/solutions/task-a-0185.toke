m=wordcount;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=wordCount(input);j.print(result);};f=wordCount(s:Str):i64{let n=s.len;let count=mut.0;let inWord=mut.false;lp(let i=0;i<n;i=i+1){let c=s.get(i);if(c=32){if(inWord){count=count+1;inWord=false}}el{inWord=true}};if(inWord){count=count+1};<count};
