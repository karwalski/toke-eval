m=slidingmax;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input.get(0);let k=input.get(1);let n=arr.len;let result=mut.@();lp(let i=0;i+k<=n;i=i+1){let max=mut.arr.get(i);lp(let q=i+1;q<i+k;q=q+1){if(arr.get(q)>max){max=arr.get(q)}};result=result+@(max)};j.print(result)};
