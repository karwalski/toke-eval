m=prefixmin;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let result=prefixmin(parsed);j.print(result);};f=prefixmin(arr:@i64):@i64{let n=arr.len;let result=mut.@();let currentmin=mut.0;if(n>0){currentmin=arr.get(0);result=result+@(currentmin);lp(let i=1;i<n;i=i+1){let current=arr.get(i);if(current<currentmin){currentmin=current;};result=result+@(currentmin);};};<result};