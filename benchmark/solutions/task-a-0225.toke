m=merge;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=mergesort(input);j.print(result);};f=mergesort(arrs:@@i64):@i64{let merged=mut.@();lp(let i=0;i<arrs.len;i=i+1){let current=arrs.get(i);let j=mut.0;let k=mut.0;let temp=mut.@();lp(let k=0;k<merged.len;k=k+1){temp=temp+@(merged.get(k));};let merged=mut.temp;let j=mut.0;let k=mut.0;lp(let k=0;k<current.len;k=k+1){let currentval=current.get(k);let mergedval=merged.get(j);if(currentval<mergedval){merged=merged+@(currentval);j=j+1;}el{merged=merged+@(mergedval);j=j+1;};};};<merged};