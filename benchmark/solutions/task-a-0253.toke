m=mode;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let result=mode(arr);j.print(result);};f=mode(arr:@i64):i64{let n=arr.len;if(n=0){<-1};let maxCount=mut.0;let modeVal=mut.arr.get(0);lp(let i=0;i<n;i=i+1){let current=arr.get(i);let count=mut.0;lp(let j=0;j<n;j=j+1){if(arr.get(j)=current){count=count+1;};};if(count>maxCount){maxCount=count;modeVal=current;}el{if(count=maxCount){if(current<modeVal){modeVal=current;};};};};<modeVal};
