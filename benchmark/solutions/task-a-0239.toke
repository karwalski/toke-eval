m=longestCommonPrefix;f=commonPrefix(val:Str;other:Str):Str{if(val=other){<val};let vlen=val.len;let olen=other.len;let minlen=mut.vlen;if(olen<vlen){minlen=olen};let i=mut.0 as u64;lp(let j=0 as u64;j<minlen;j=j+1){if(!(val.get(j)=other.get(j))){i=j;br};i=j+1};let result=mut."";lp(let k=0 as u64;k<i;k=k+1){result=result+val.get(k)as Str};<result};f=longestCommonPrefix(val:Str;other:Str):Str{if(val=other){<val};let vlen=val.len;let olen=other.len;let minlen=mut.vlen;if(olen<vlen){minlen=olen};let i=mut.0 as u64;lp(let j=0 as u64;j<minlen;j=j+1){if(!(val.get(j)=other.get(j))){i=j;br};i=j+1};let result=mut."";lp(let k=0 as u64;k<i;k=k+1){result=result+val.get(k)as Str};<result};f=longestCommonPrefixCommonprefix(val:Str;other:Str):Str{<longestCommonPrefix(commonPrefix(val;other))};f=main():i64{let input=std.json.parse(std.io.read());let val=input.get(0);let other=input.get(1);let result=longestCommonPrefix(val;other);std.io.write(result);};
