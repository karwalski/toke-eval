m=diff;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let first=input.get(0);let second=input.get(1);let result=diff(first;second);j.print(result);};f=diff(first:@i64;second:@i64):@i64{let res=mut.@();lp(let i=0;i<first.len;i=i+1){let v=first.get(i);let found=mut.false;lp(let j=0;j<second.len;j=j+1){if(second.get(j)=v){found=true;br;};};if(!(found)){res=res+@(v);};};<res};
