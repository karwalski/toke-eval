m=parseint;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=parseint(input);j.print(result);};f=parseint(s:str):i64{let n=s.len;let result=mut.0;let idx=mut.0;let isneg=mut.false;if(idx<n){let ch=s.charat(idx);if(ch==45){isneg=true;idx=idx+1;}};if(idx==n){<0};let num=mut.0;lp(let i=idx;i<n;i=i+1){let ch=s.charat(i);let digit=ch-48;if(digit<0){<0};if(digit>9){<0};num=num*10+digit;};if(isneg){num=0-num};<num};