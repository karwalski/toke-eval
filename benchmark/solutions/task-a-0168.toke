m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let maxVal=mut.arr.get(0);let maxIdx=mut.0;lp(let i=1;i<arr.len;i=i+1){if(arr.get(i)>maxVal){maxVal=arr.get(i);maxIdx=i;};};let sum=mut.0;lp(let i=0;i<arr.len;i=i+1){if(!(i=maxIdx)){sum=sum+arr.get(i);};};j.print(sum);};
