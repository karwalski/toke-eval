m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input as @i64;let maxval=mut.arr.get(0);let maxidx=mut.0;lp(let i=1;i<arr.len;i=i+1){if(arr.get(i)>maxval){maxval=arr.get(i);maxidx=i;};};let sum=mut.0;lp(let i=0;i<arr.len;i=i+1){if(!(i==maxidx)){sum=sum+arr.get(i);};};j.print(sum);};