m=flatten;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=flatten(input);j.print(result);};f=flatten(arr:@@i64):@i64{let result=mut.@();let outer=arr.len;lp(let i=0;i<outer;i=i+1){let inner=arr.get(i);let innerLen=inner.len;lp(let j=0;j<innerLen;j=j+1){let sub=inner.get(j);let subLen=sub.len;lp(let k=0;k<subLen;k=k+1){result=result+@(sub.get(k));};};};<result};
