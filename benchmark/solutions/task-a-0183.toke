m=longestRun;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let result=longestRun(input);j.print(result);};f=longestRun(s:Str):i64{let n=s.len;if(n=0){<0};let longest=mut.1;let current=mut.1;lp(let i=1;i<n;i=i+1){if(s.get(i)=s.get(i-1)){current=current+1}el{if(current>longest){longest=current};current=1}};if(current>longest){longest=current};<longest};
