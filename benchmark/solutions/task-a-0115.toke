m=reverseint;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let n=input as i64;let result=reverseint(n);j.print(result);};f=reverseint(n:i64):i64{let isneg=false;let absn=n;if(n<0){let isneg=true;let absn=0-n};let result=mut.0;let temp=absn;lp(let i=0;temp>0;i=i+1){let digit=temp-temp/10*10;let result=result*10+digit;let temp=temp/10};if(isneg){<0-result}el{<result}};