m=sort;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input;let result=sort(arr);j.print(result);};f=sort(arr:@i64):@i64{let evens=mut.@();let odds=mut.@();lp(let i=0;i<arr.len;i=i+1){let elem=arr.get(i);let mod=elem-elem/2*2;if(mod=0){evens=evens+@(elem);}el{odds=odds+@(elem);};};let sortedEvens=sortHelper(evens);let sortedOdds=sortHelper(odds);let result=sortedEvens+sortedOdds;<result};f=sortHelper(arr:@i64):@i64{let n=arr.len;let result=mut.arr;lp(let i=0;i<n;i=i+1){lp(let j=0;j<n-1;j=j+1){let lhs=result.get(j);let rhs=result.get(j+1);if(lhs>rhs){let tmp=result.get(j);result.set(j;result.get(j+1));result.set(j+1;tmp);};};};<result};
