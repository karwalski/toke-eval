m=main;i=j:std.json;i=s:std.str;f=main():i64{let input=s.argv(1);let parsed=j.parse(input);let arr=parsed;let n=arr.len;let max1=mut.arr.get(0);let max2=mut.arr.get(1);if(max1<max2){let tmp=max1;max1=max2;max2=tmp};lp(let i=2;i<n;i=i+1){let val=arr.get(i);if(val>max1){max2=max1;max1=val}el{if(val>max2){max2=val}}};let result=max1*max2;j.print(result)};
