m=intersect;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let a=input.get(0);let b=input.get(1);let result=intersect(a;b);j.print(result);};f=intersect(a:@i64;b:@i64):@i64{let result=mut.@();lp(let i=0;i<a.len;i=i+1){let elem=a.get(i);let found=mut.false;lp(let j=0;j<b.len;j=j+1){if(b.get(j)=elem){found=true;};};if(found){let alreadyIn=mut.false;lp(let k=0;k<result.len;k=k+1){if(result.get(k)=elem){alreadyIn=true;};};if(!(alreadyIn)){result=result+@(elem);};};};<result};
