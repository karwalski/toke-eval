m=sortdesc;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=mut.@();lp(let i=0;i<input.len;i=i+1){arr=arr+@(input.get(i));};let n=arr.len;lp(let i=0;i<n;i=i+1){lp(let j=0;j<n-1;j=j+1){if(arr.get(j)<arr.get(j+1)){let tmp=arr.get(j);arr.set(j;arr.get(j+1));arr.set(j+1;tmp);};};};j.print(arr);};
