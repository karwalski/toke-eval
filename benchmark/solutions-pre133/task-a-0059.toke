m=sliding;i=j:std.json;i=s:std.str;f=main():i64{let input=j.parse(s.argv(1));let arr=input.get(0);let k=input.get(1);let n=arr.len;let result=mut.@();let sum=mut.0;lp(let i=0;i<k;i=i+1){sum=sum+arr.get(i);};result=result+@(sum);lp(let i=k;i<n;i=i+1){sum=sum-arr.get(i-k);sum=sum+arr.get(i);result=result+@(sum);};j.print(result);};
